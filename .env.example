KEDB_ENV=dev
KEDB_OBSERVABILITY_ENABLED=false
AI_OBSERVABILITY_ENDPOINT=
AI_OBSERVABILITY_API_KEY=
KEDB_DATABASE_URL=postgresql+psycopg://kedb:kedb@localhost:5432/kedb
DATABRICKS_HOST=https://<workspace>
DATABRICKS_TOKEN=
DATABRICKS_AI_SEARCH_ENDPOINT=kedb-search
DATABRICKS_AI_SEARCH_INDEX=main.kedb.article_chunks_index
DATABRICKS_MODEL_ENDPOINT=databricks-gpt-oss-20b
KEDB_SEARCH_TOP_K=5

# Article duplicate detection (cosine >= threshold rejects).
DATABRICKS_EMBEDDING_ENDPOINT=databricks-qwen3-embedding-0-6b
KEDB_DUPLICATE_THRESHOLD=0.90
# Increment whenever the endpoint's underlying embedding model changes.
KEDB_EMBEDDING_MODEL_VERSION=v1

# Below approval cutoff: approve; between cutoffs: human review; >= duplicate cutoff: reject.
KEDB_AUTO_APPROVE_THRESHOLD=0.60
KEDB_EMBEDDING_BATCH_SIZE=16
